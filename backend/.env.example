# Runtime configuration for the FastAPI Delivery Intelligence API.
# Copy to `backend/.env` for local use (never committed). Every value is optional;
# the defaults match local development and `docker compose`.

# Port the HTTP server binds. Render and Railway override this automatically.
PORT=8000

# Where the service looks for the trained model.
# Default: backend/models/eta_model.joblib (mounted into /app/models by docker compose).
# ETA_MODEL_PATH=/app/models/eta_model.joblib

# Comma-separated list of browser origins allowed to call the API directly.
# The wildcard default is demo-friendly; restrict it in production, e.g.:
# CORS_ALLOWED_ORIGINS=https://your-dashboard.vercel.app
CORS_ALLOWED_ORIGINS=*
